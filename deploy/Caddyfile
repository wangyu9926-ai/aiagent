# Public HTTPS: PORTAL_DOMAIN must resolve to this host and ports 80/443
# (or PORTAL_HTTP_PORT/PORTAL_HTTPS_PORT) must be reachable for ACME.
{$PORTAL_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy portal:9180

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format console
	}
}
